# Get a free key at https://www.themoviedb.org/settings/api
# Required for in-app search and for regenerating the local film DB:
#   npm run build:films
VITE_TMDB_API_KEY=

# Supabase (optional - cloud sync across browsers)
# Create a project at https://supabase.com -> Project Settings -> API
# Copy Project URL and the anon / publishable key into the vars below.
# Then run supabase/schema.sql in the SQL editor.
# Auth -> URL Configuration: add http://localhost:5173 (and your prod URL)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only seed key for `npm run upload:catalog` (Project Settings → API → service_role).
# Never prefix with VITE_ and never commit this value — it bypasses RLS.
# SUPABASE_SERVICE_ROLE_KEY=
